{
  "name": "bussola-de-produto",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --require ./scripts/tsx-userinfo.cjs --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "index:books": "python scripts/index_books.py",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "eval:live": "node --require ./scripts/tsx-userinfo.cjs --conditions=react-server --import tsx scripts/evaluate-live.ts",
    "eval:smoke": "node --require ./scripts/tsx-userinfo.cjs --conditions=react-server --import tsx scripts/check-chat-route.ts",
    "check:release": "node --require ./scripts/tsx-userinfo.cjs --conditions=react-server --import tsx scripts/check-release.ts",
    "prebuild": "node scripts/prepare-books.cjs",
    "predev": "node scripts/prepare-books.cjs",
    "eval:projects": "node --conditions=react-server --import tsx scripts/evaluate-projects-v2.ts"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "@upstash/redis": "1.41.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "openai": "7.53.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
